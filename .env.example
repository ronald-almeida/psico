HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/orders.sqlite
# Configure no servidor; nunca no código público.
NEXUM_CHAT_ID=
NEXUM_API_CREDENTIAL=
# Segredo aleatório com pelo menos 32 caracteres, exclusivo dos webhooks Pix.
NEXUM_WEBHOOK_SECRET=
# URLs privadas do Pushcut para as notificações configuradas na conta.
PUSHCUT_PIX_PENDING_URL=
PUSHCUT_PIX_PAID_URL=
# Opcionais: URLs HTTPS da área de membros de cada produto, mostradas após confirmação.
CLUBE_LUMA_ACCESS_URL=
LUMA_PRO_ACCESS_URL=
# Na Vercel, conecte um Blob privado ao projeto para obter BLOB_STORE_ID e OIDC.
