{
  "name": "psico-black-friday-pix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --import ./scripts/test-env.js --test --test-isolation=none test/*.test.js",
    "check": "node scripts/check.js",
    "build": "pnpm check && pnpm test"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "qrcode": "1.5.4"
  }
}
